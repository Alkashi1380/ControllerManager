<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Version de l'appli : la CI la remplace par celle du tag (v1.2.3 → 1.2.3) via /p:Version -->
    <Version>1.0.1</Version>
    <Product>ControllerManager</Product>
    <Description>Gestionnaire de manettes PS5 / PS4 / Xbox : profils par jeu, raccourcis, macros, gâchettes adaptatives</Description>
    <Copyright>© 2026 Alkashi1380</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le projet de tests a son propre .csproj : ne pas compiler ses fichiers dans l'appli -->
    <Compile Remove="ControllerManager.Tests\**" />
    <None Remove="ControllerManager.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="UI\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="profiles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Sources de l'installateur : hors de la compilation de l'appli -->
    <None Remove="installer\**" />
  </ItemGroup>

</Project>
